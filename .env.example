# Copy to .env and set a password. .env is gitignored; never commit it.
#   cp .env.example .env && sed -i "s/CHANGEME/$(openssl rand -hex 16)/" .env
POSTGRES_USER=loadout
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=loadout
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Host 6379 is often taken by another redis; compose maps 6380.
REDIS_PORT=6380

# Signing key for session JWTs. Required, no default.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGEME

# Where magic links point. Unset, it is http://localhost:$WEB_PORT (3000), the dev server.
# WEB_URL=https://loadout.example.com
