# Copy to .env and set a password. .env is gitignored; never commit it.
#   cp .env.example .env && sed -i "s/CHANGEME/$(openssl rand -hex 16)/" .env
POSTGRES_USER=loadout
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=loadout
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Signing key for session JWTs. Required, no default.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGEME
